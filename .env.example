# cp .env.example .env して値を入れる（.env は git に入れない）
DAYTONA_API_KEY=

# コードを書かせる LLM（1 つだけ）: openai（既定 = OpenAI 互換 API）| anthropic
LLM_PROVIDER=openai
LLM_BASE_URL=https://<your-nosana-endpoint>/v1
LLM_MODEL=qwen3.8-27b
LLM_LABEL=Nosana · Qwen 3.8 27B
# 認証なしのセルフホスト vLLM なら空のまま
LLM_API_KEY=
# 思考型モデルの思考を切り、トークンをすべてコードに使う
LLM_EXTRA={"chat_template_kwargs":{"enable_thinking":false}}

# LLM_PROVIDER=anthropic のときだけ必要
ANTHROPIC_API_KEY=

# 任意: LLM_TIMEOUT=90 / LLM_MAX_TOKENS=3000 / FANOUT_MAX=8 / CARD_TTL_MIN=2
# 隔離の証明（攻撃してみる）を画面に出すなら 1
# SHOW_PROBES=1
# KVM Sandbox（Tier 1 では不可、自動で通常 Sandbox に切り替わる）
# NARABANAI_KVM=1
